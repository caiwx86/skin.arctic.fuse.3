<contents>
    <rules name="parts_onclick">
        <rule>
            <condition>{item_target}!=</condition>
            <value>
                <![CDATA[
                <onclick>ActivateWindow({item_target},{item_path},return)</onclick>
                ]]>
            </value>
        </rule>
        <rule>
            <condition>{item_path}==Reboot</condition>
            <value>
                <![CDATA[
                <onclick>Skin.SetString(Reboot.Mode,reboot)</onclick>
                <onclick>ActivateWindow(1197)</onclick>
                <!-- Use Kodi's native reboot action. System.Exec only accepts an executable
                     path and does not reliably run the previous comma-separated shell chain. -->
                <onclick>AlarmClock(RebootForce,Reboot,00:05,silent)</onclick>
                ]]>
            </value>
        </rule>
        <rule>
            <condition>{item_path}==RebootToAndroid</condition>
            <value>
                <![CDATA[
                <onclick>Skin.SetString(Reboot.Mode,reboot)</onclick>
                <onclick>ActivateWindow(1197)</onclick>
                <!-- CoreELEC's helper switches the next boot target and performs the reboot. -->
                <onclick>AlarmClock(RebootForce,System.ExecWait(/usr/sbin/rebootfromnand),00:05,silent)</onclick>
                ]]>
            </value>
        </rule>
        <rule>
            <condition>{item_path}==Powerdown</condition>
            <value>
                <![CDATA[
                <onclick>Skin.SetString(Reboot.Mode,shutdown)</onclick>
                <onclick>ActivateWindow(1197)</onclick>
                <onclick>AlarmClock(RebootForce,Powerdown,00:05,silent)</onclick>
                ]]>
            </value>
        </rule>
        <rule>
            <condition>{item_path}==Custom_Submenu</condition>
            <value>
                <![CDATA[
                <onclick condition="!String.IsEqual(Window(Home).Property(SubGroup.IsVisible),{item_guid})">SetProperty(SubGroup.IsVisible,{item_guid},Home)</onclick>
                <onclick condition="String.IsEqual(Window(Home).Property(SubGroup.IsVisible),{item_guid})">ClearProperty(SubGroup.IsVisible,Home)</onclick>
                ]]>
            </value>
        </rule>
        <rule>
            <condition>True</condition>
            <value>
                <![CDATA[
                <onclick>{item_path}</onclick>
                ]]>
            </value>
        </rule>
    </rules>
</contents>
