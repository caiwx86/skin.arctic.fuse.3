<contents>
    <rules name="parts_onclick">
        <rule>
            <condition>{item_target}!=</condition>
            <value>
                <![CDATA[
                <onclick>ActivateWindow({item_target},{item_path},return)</onclick>
                ]]>
            </value>
        </rule>
        <rule>
            <condition>{item_path}==Reboot</condition>
            <value>
                <![CDATA[
                <onclick>Skin.SetString(Reboot.Mode,reboot)</onclick>
                <onclick>ActivateWindow(1197)</onclick>
                <onclick>AlarmClock(RebootForce,System.Exec("/bin/sh, -c, /sbin/reboot -f || /usr/sbin/reboot -f || busybox reboot -f || echo b > /proc/sysrq-trigger"),00:05,silent)</onclick>
                <onclick>AlarmClock(RebootFallback,Reboot,00:08,silent)</onclick>
                ]]>
            </value>
        </rule>
        <rule>
            <condition>{item_path}==RebootToAndroid</condition>
            <value>
                <![CDATA[
                <onclick>Skin.SetString(Reboot.Mode,reboot)</onclick>
                <onclick>ActivateWindow(1197)</onclick>
                <onclick>AlarmClock(RebootForce,System.Exec("/bin/sh, -c, /usr/sbin/rebootfromnand; /sbin/reboot -f || /usr/sbin/reboot -f || busybox reboot -f || echo b > /proc/sysrq-trigger"),00:05,silent)</onclick>
                <onclick>AlarmClock(RebootFallback,Reboot,00:08,silent)</onclick>
                ]]>
            </value>
        </rule>
        <rule>
            <condition>{item_path}==Powerdown</condition>
            <value>
                <![CDATA[
                <onclick>Skin.SetString(Reboot.Mode,shutdown)</onclick>
                <onclick>ActivateWindow(1197)</onclick>
                <onclick>AlarmClock(RebootForce,System.Exec("/bin/sh, -c, /sbin/poweroff -f || /usr/sbin/poweroff -f || busybox poweroff -f || echo o > /proc/sysrq-trigger"),00:05,silent)</onclick>
                <onclick>AlarmClock(RebootFallback,Powerdown,00:08,silent)</onclick>
                ]]>
            </value>
        </rule>
        <rule>
            <condition>{item_path}==Custom_Submenu</condition>
            <value>
                <![CDATA[
                <onclick condition="!String.IsEqual(Window(Home).Property(SubGroup.IsVisible),{item_guid})">SetProperty(SubGroup.IsVisible,{item_guid},Home)</onclick>
                <onclick condition="String.IsEqual(Window(Home).Property(SubGroup.IsVisible),{item_guid})">ClearProperty(SubGroup.IsVisible,Home)</onclick>
                ]]>
            </value>
        </rule>
        <rule>
            <condition>True</condition>
            <value>
                <![CDATA[
                <onclick>{item_path}</onclick>
                ]]>
            </value>
        </rule>
    </rules>
</contents>