    <onload condition="System.HasAddon(plugin.video.filteredmovies)">Close</onload>
    <onload condition="!System.HasAddon(plugin.video.filteredmovies)">RunScript(script.skinvariables,run_multisearch,tmdbhelper_container,progress_dialog$VAR[Value_MultiSearch_Layout_Param]$VAR[Value_MultiSearch_Discover_Param])</onload>
    <controls />
</window>
