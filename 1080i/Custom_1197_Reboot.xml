<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1197">
    <!-- Forced restart screen: 5 second countdown, then a hard system reboot
         (bypasses Kodi's slow shutdown). Back/ESC is swallowed so the dialog
         cannot be cancelled. -->
    <zorder>1200</zorder>
    <onload>SetProperty(Reboot.Countdown,5,1197)</onload>
    <onload>AlarmClock(RebootCd4,SetProperty(Reboot.Countdown,4,1197),00:01,silent)</onload>
    <onload>AlarmClock(RebootCd3,SetProperty(Reboot.Countdown,3,1197),00:02,silent)</onload>
    <onload>AlarmClock(RebootCd2,SetProperty(Reboot.Countdown,2,1197),00:03,silent)</onload>
    <onload>AlarmClock(RebootCd1,SetProperty(Reboot.Countdown,1,1197),00:04,silent)</onload>
    <onload>AlarmClock(RebootCd0,SetProperty(Reboot.Countdown,0,1197),00:05,silent)</onload>
    <onback>SetProperty(Reboot.Blocked,true,1197)</onback>
    <controls>
        <control type="group">
            <control type="image">
                <width>100%</width>
                <height>100%</height>
                <texture colordiffuse="E6000000">common/white.png</texture>
            </control>
            <control type="label">
                <top>44%</top>
                <width>100%</width>
                <height>50</height>
                <align>center</align>
                <label>$LOCALIZE[32095]</label>
                <font>font_title_midi</font>
                <textcolor>main_fg_90</textcolor>
            </control>
            <control type="label">
                <top>50%</top>
                <width>100%</width>
                <height>100</height>
                <align>center</align>
                <label>$INFO[Window.Property(Reboot.Countdown)]</label>
                <font>font_title_huge</font>
                <textcolor>$VAR[ColorHighlight]</textcolor>
            </control>
        </control>
    </controls>
</window>
