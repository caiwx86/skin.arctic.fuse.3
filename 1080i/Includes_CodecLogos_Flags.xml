<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <!--
        Codec logos shown on the video window at playback start.

        VideoFullScreen.xml already called these includes (three positions:
        left / centre / right), but their definitions were never shipped, so
        Kodi logged every call as an invalid include.  The definitions below
        use the u3k/ assets that ship with the skin.

        The CodecStartupLogos wrapper is only pulled in when the matching
        osd.use*CodecStartupLogos setting is on, so a normal playback start
        does not build ~250 unused controls.
    -->

    <include name="CodecStartupLogos">
        <definition>
			
            <include content="VS10_Indicator_Flag">
                <param name="groupId">54</param>
                <param name="imageId">55</param>
                <param name="visible">[!String.IsEmpty(VideoPlayer.HdrType) + String.Contains(Player.Process(amlogic.eoft_gamut),SDR)] | [[String.IsEmpty(VideoPlayer.HdrType) | String.Contains(VideoPlayer.HdrType,dolbyvision) | String.Contains(VideoPlayer.HdrType,hlg)] + String.Contains(Player.Process(amlogic.eoft_gamut),HDR10)] | [[String.IsEmpty(VideoPlayer.HdrType) | String.IsEqual(VideoPlayer.HdrType,hdr10) | String.Contains(VideoPlayer.HdrType,hdr10plus) | String.Contains(VideoPlayer.HdrType,hlg)] + String.Contains(Player.Process(amlogic.eoft_gamut),DV)]</param>
                <param name="texture">u3k/VS10.png</param>
                <param name="colordiffuse">AB16A34A</param>
            </include>
			
            <include content="Convert_SDR_Flag">
                <param name="groupId">56</param>
                <param name="imageId">57</param>
                <param name="visible">!String.IsEmpty(VideoPlayer.HdrType) + String.Contains(Player.Process(amlogic.eoft_gamut),SDR)</param>
                <param name="texture">u3k/SDR.png</param>
                <param name="colordiffuse">dialog_fg_90</param>
            </include>
			
            <include content="Convert_HDR10_Flag">
                <param name="groupId">58</param>
                <param name="imageId">59</param>
                <param name="visible">[String.IsEmpty(VideoPlayer.HdrType) | String.Contains(VideoPlayer.HdrType,dolbyvision) | String.Contains(VideoPlayer.HdrType,hlg)] + String.Contains(Player.Process(amlogic.eoft_gamut),HDR10)</param>
                <param name="texture">u3k/HDR10.png</param>
                <param name="colordiffuse">dialog_fg_90</param>
            </include>
			
            <include content="Convert_DV_Flag">
                <param name="groupId">60</param>
                <param name="imageId">61</param>
                <param name="visible">[String.IsEmpty(VideoPlayer.HdrType) | String.IsEqual(VideoPlayer.HdrType,hdr10) | String.Contains(VideoPlayer.HdrType,hdr10plus) | String.Contains(VideoPlayer.HdrType,hlg)] + String.Contains(Player.Process(amlogic.eoft_gamut),DV)</param>
                <param name="texture">u3k/Dolby_Vision.png</param>
                <param name="colordiffuse">dialog_fg_90</param>
