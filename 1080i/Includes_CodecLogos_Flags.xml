    <include name="VS10_Indicator_Flag">
        <param name="groupId"/>
        <param name="imageId"/>
        <param name="visible">true</param>
        <param name="texture"/>
        <param name="colordiffuse">FFFFFFFF</param>
        <definition>
        <control type="group" id="$PARAM[groupId]">
            <control type="image" id="$PARAM[imageId]">
                <left>30</left>
                <top>18</top>
                <width>150</width>
                <height>52</height>
                <aspectratio>keep</aspectratio>
                <visible>$PARAM[visible]</visible>
                <texture colordiffuse="$PARAM[colordiffuse]">$PARAM[texture]</texture>
                <animation effect="fade" start="0" end="100" time="300">Visible</animation>
            </control>
        </control>
        </definition>
    </include>
